{
  "schema": "noise-aware-compilation.config-v2/1",
  "description": "v2 benchmark (SPEC_V2.md rev 1). Committed before any v2 run; drift strengths, draw count and drift model are fixed here and are not changed after any result is seen (X11).",
  "base_seeds": [
    20261021,
    20261022,
    20261023
  ],
  "evaluation_seed_rule": "sha256('eval-v2|<base_seed>|<case_id>|<mapping>|<chunk>')[:8] & (2**63-1)",
  "min_shots_per_seed": 200000,
  "max_shots_per_seed": 25600000,
  "precision_rule": {
    "target_relative_halfwidth": 0.1,
    "description": "As v1 (DECISIONS.md D8): shots per seed are doubled for every placement of the case together until each placement's pooled Wilson 95% half-width <= 10% of its P_L, or max_shots_per_seed is reached."
  },
  "drift": {
    "strengths": [
      0.0,
      0.1,
      0.25,
      0.5
    ],
    "draws": 20,
    "seed_rule": "sha256('drift-v2|<device>|<draw>')[:8] & (2**63-1)",
    "model": "SPEC_V2.md R-S2: one factor exp(delta*z) per channel; Pauli channels capped at total 1 by proportional scaling, flips at 0.5; draw k uses the same deviates at every strength"
  },
  "methods": [
    "v1",
    "decoder-graph",
    "lowest-summed-error",
    "qiskit-vf2"
  ],
  "default_scorer_before_r_g7": "v1",
  "qiskit_version": "2.5.2",
  "bootstrap": {
    "replicates": 4000,
    "seed": 20261031,
    "description": "M6 interval: percentile bootstrap resampling draws and redrawing every placement's pooled failure count from Binomial(shots, P_L)"
